# ─── App ───────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Riyadh
API_PORT=3001
WEB_PORT=5173
APP_URL=http://localhost:5173

# ─── Data ──────────────────────────────────────────────
DATABASE_URL=postgresql://mip:mip_dev_password@localhost:5433/mip
REDIS_URL=redis://localhost:6380

# ─── Auth (CHANGE IN PRODUCTION) ───────────────────────
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# First production seed only. Store these in Coolify; never commit real values.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-random-password-of-16-or-more-characters

# ─── SAFETY FLAGS - defaults are intentionally safe ────
# No connection to the real X API is possible while this is false.
LIVE_X_API=false
# Runs scheduler + budget gate + query compiler, but sends no request.
X_DRY_RUN=false
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_STREAM_ENABLED=false
X_STREAM_RULE_REFRESH_SECONDS=60
X_STREAM_RECONNECT_MAX_SECONDS=60

# Automatic dictionary collection (only effective when LIVE_X_API=true)
AUTO_COLLECTION_ENABLED=false
AUTO_COLLECTION_TICK_SECONDS=30
AUTO_COLLECTION_INTERVAL_MINUTES=2
AUTO_COLLECTION_MAX_RESULTS=10
AUTO_COLLECTION_MAX_BACKOFF_MINUTES=5
AUTO_COLLECTION_EXCLUDED_USERS=

# ─── AI ────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=
# Internal customer-service data must never reach an external provider
# unless this is explicitly enabled AND governance has approved it.
ALLOW_INTERNAL_DATA_TO_EXTERNAL_AI=false

# ─── Embeddings (تصنيف التفاعلات — Stage 2, docs/AI_PIPELINE.md §4) ──
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
STAGE2_CONFIDENCE_THRESHOLD=0.84
STAGE2_MIN_MARGIN=0.05
STAGE3_EXISTING_MIN_SIMILARITY=0.6
TOPIC_SUGGESTION_SIMILARITY=0.82
TOPIC_SUGGESTION_MIN_SUPPORT=3
# Read by apps/ai directly, not by apps/api.
AI_PORT=8000
EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Stage 3 — LLM topic discovery for posts that match no existing centroid well.
# Read by apps/ai directly, not by apps/api.
LABEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Runs classification (embed + match + LLM topic discovery) automatically —
# no manual "تشغيل التصنيف" click needed.
AUTO_CLASSIFICATION_ENABLED=false
AUTO_CLASSIFICATION_TICK_SECONDS=300
AUTO_CLASSIFICATION_BATCH_SIZE=20
SIGNAL_CLUSTER_THRESHOLD=0.70
SIGNAL_MIN_FAMILIES=2
SIGNAL_LOOKBACK_DAYS=7

# ─── News & Web Monitoring — Phase 1 (source registry only) ──────────
NEWS_FETCH_TIMEOUT_MS=10000
NEWS_MAX_RESPONSE_BYTES=10000000
NEWS_FETCH_ENABLED=false
NEWS_FETCH_TICK_SECONDS=30
NEWS_FETCH_INTERVAL_MINUTES=5
NEWS_FETCH_BATCH_SIZE=25
NEWS_FETCH_MAX_BACKOFF_MINUTES=5
NEWS_DOMAIN_MIN_DELAY_MS=1000

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info
